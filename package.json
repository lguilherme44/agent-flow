{
  "name": "agent-flow",
  "version": "0.1.0",
  "description": "Orchestration layer for AI-assisted development. Runner-agnostic, provider-agnostic, project-agnostic.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-flow": "./dist/bin/agent-flow.js"
  },
  "files": [
    "dist",
    "prompts",
    "templates",
    "apps/web/dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test bin apps/web/src",
    "check": "npm run typecheck && npm run typecheck:e2e && npm run lint && npm run test && npm run test:web",
    "build:web": "npm run build --workspace @agent-flow/web",
    "dev:web": "npm run dev --workspace @agent-flow/web",
    "test:web": "npm run test --workspace @agent-flow/web",
    "test:e2e": "npm run test:e2e --workspace @agent-flow/web",
    "test:visual": "npm run test:visual --workspace @agent-flow/web",
    "test:visual:update": "npm run test:visual:update --workspace @agent-flow/web",
    "typecheck:e2e": "npm run typecheck:e2e --workspace @agent-flow/web"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "commander": "^12.1.0",
    "fastify": "^5.11.3",
    "yaml": "^2.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "workspaces": [
    "apps/*"
  ]
}
