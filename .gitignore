node_modules/
dist/
coverage/
*.tsbuildinfo
.DS_Store

# Local tooling state, not part of the project
.atl/

# Working documents that predate the public repository
agent-flow-implementation-spec.md
agent-flow-mvp1-plan.md

# agent-flow's own run state, when used on itself
.agent-flow/runs/
.agent-flow/cache/
.agent-flow/current-run

# Playwright's per-run output. The baselines under
# apps/web/visual/__screenshots__ are committed; this is the scratch space
# where a failing run writes its actual and diff images.
apps/web/visual/.results/
apps/web/e2e/.results/
apps/web/playwright-report/
apps/web/test-results/

# Packaging smoke output: a tarball and the throwaway prefix it is installed into.
.packaging/
*.tgz

# The packaging smoke renames the checkout's dashboard bundle aside to prove the
# packaged server is not reading it, and restores it afterwards. A run killed at the
# wrong moment leaves this behind; it is a build artifact, not a loss.
apps/web/dist.hidden-by-packaging-smoke/
